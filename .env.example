# Server-only Neon PostgreSQL connection string.
# Never prefix this variable with VITE_ and never expose it to browser code.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Protected local-only setup inputs for `npm run auth:create-staff`.
# Keep these only in ignored .env.local; never commit or log them.
STAFF_EMAIL=staff@example.test
STAFF_PASSWORD=replace-with-a-long-local-password
STAFF_NAME=Medewerker
STAFF_PHONE=+31 6 00000000
