# Server-only Neon PostgreSQL connection string.
# Never prefix this variable with VITE_ and never expose it to browser code.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Protected local-only setup inputs for `npm run auth:create-owner`.
# Keep these only in ignored .env.local; never commit or log them.
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD=replace-with-a-long-local-password
OWNER_NAME=Eigenaar
OWNER_PHONE=+31 6 00000000
TRUSTED_PROXY=false

# Server-only Web Push-configuratie (nooit VITE_-prefix, nooit naar de client).
# Alleen de publieke sleutel wordt via een gecontroleerde serverfunctie
# aan de browser beschikbaar gesteld. Vul echte waarden pas in de
# deploymentomgeving in; VAPID_SUBJECT pas zodra het zakelijke
# e-mailadres bekend is.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Geheim voor de dagelijkse Vercel Cron-route (/api/cron/push-dispatch).
# Vercel stuurt dit automatisch als Authorization Bearer-header mee.
CRON_SECRET=
