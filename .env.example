# Server-only Neon PostgreSQL connection string.
# Never prefix this variable with VITE_ and never expose it to browser code.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Protected local-only setup inputs for `npm run auth:create-owner`.
# Keep these only in ignored .env.local; never commit or log them.
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD=replace-with-a-long-local-password
OWNER_NAME=Eigenaar
OWNER_PHONE=+31 6 00000000
TRUSTED_PROXY=false
